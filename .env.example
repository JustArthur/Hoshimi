# --- Application ---
APP_NAME=Hoshimi
APP_ENV=development
APP_URL=http://localhost:8080
APP_DEBUG=true

# --- APIs externes ---
ANILIST_API_URL=https://graphql.anilist.co
TMDB_API_KEY=

# --- Stockage des médias (chemins Docker, utilisés par PHP-FPM) ---
ANIMES_PATH=/media/animes
FILMS_PATH=/media/films
SERIES_PATH=/media/series
IMAGES_PATH=/var/www/html/public/images

# --- Chemins hôte Windows (utilisés par les scripts CLI) ---
ANIMES_HOST_PATH=
FILMS_HOST_PATH=
SERIES_HOST_PATH=

# --- Accès admin (token cookie) ---
ACCESS_TOKEN=
LAN_HOST=

# --- Jellyfin (moteur de streaming) ---
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
JELLYFIN_STREAMING_ENABLED=false

# --- ProtonVPN (tunnel Gluetun pour qBittorrent) ---
PROTON_WG_PRIVATE_KEY=
PROTON_WG_ADDRESSES=
PROTON_VPN_COUNTRY=